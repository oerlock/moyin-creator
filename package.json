{
  "name": "moyin-creator",
  "productName": "魔因漫创",
  "version": "0.2.3",
  "description": "AI 驱动的动漫/短剧分镜创作工具",
  "author": "MemeCalculate",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/MemeCalculate/moyin-creator.git"
  },
  "homepage": "https://github.com/MemeCalculate/moyin-creator",
  "bugs": {
    "url": "https://github.com/MemeCalculate/moyin-creator/issues"
  },
  "updateConfig": {
    "manifestUrl": "http://68.64.176.186/moyin/version.json",
    "defaultGithubUrl": "https://github.com/MemeCalculate/moyin-creator",
    "defaultBaiduUrl": "https://pan.baidu.com/s/1ImH6tOIiuFxIDXC0fC-6Lg",
    "defaultBaiduCode": "8888"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run dev:desktop",
    "build": "npm run build:desktop",
    "prebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prebuild-cleanup.ps1",
    "build:desktop": "npm run build -w @moyin/desktop",
    "build:win": "node ./scripts/build-desktop.mjs --win",
    "build:mac": "node ./scripts/build-desktop.mjs --mac",
    "build:mac:all": "node ./scripts/build-desktop.mjs --mac --arm64 --x64",
    "build:mac:x64": "node ./scripts/build-desktop.mjs --mac --x64",
    "build:mac:arm64": "node ./scripts/build-desktop.mjs --mac --arm64",
    "build:mac:universal": "node ./scripts/build-desktop.mjs --mac --universal",
    "build:linux": "node ./scripts/build-desktop.mjs --linux",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "npm run preview:desktop",
    "dev:web": "npm run dev -w @moyin/web -- --hostname 0.0.0.0",
    "build:web": "npm run build -w @moyin/web",
    "dev:desktop": "npm run dev -w @moyin/desktop",
    "preview:web": "npm run start -w @moyin/web",
    "preview:desktop": "npm run preview -w @moyin/desktop",
    "install:web": "npm install --workspace @moyin/web --include-workspace-root=false",
    "install:desktop": "npm install --workspace @moyin/desktop --include-workspace-root=false"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.2.2"
  },
  "main": "out/main/index.cjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "private": true
}
